# ─────────────────────────────────────────────
# NVIDIA NIM API configuration
# ─────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
EMBED_MODEL=nvidia/nv-embed-v1
RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# LLM Configuration
LLM_MAX_TOKENS=400
LLM_ENABLE_THINKING=false
LLM_FORCE_NONEMPTY_CONTENT=true

# ─────────────────────────────────────────────
# Retrieval Configuration
# ─────────────────────────────────────────────
MATCH_THRESHOLD=0.16
MATCH_COUNT=8
VECTOR_DB_PATH=vectors.db

# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://mithil0723.github.io,http://localhost:3000

# ─────────────────────────────────────────────
# LangSmith Tracing (Optional)
# ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=mithil-portfolio-rag
